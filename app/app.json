{
  "expo": {
    "name": "CoachPulse",
    "slug": "coachpulse",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "coachpulse",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": { "supportsTablet": true, "bundleIdentifier": "io.coachpulse.app" },
    "android": { "package": "io.coachpulse.app", "edgeToEdgeEnabled": true },
    "web": { "bundler": "metro", "output": "single" },
    "plugins": ["expo-router", "expo-secure-store", "expo-sqlite", "expo-status-bar"],
    "extra": {
      "apiBaseUrl": "http://localhost:8080"
    }
  }
}
