# Copy to .env for local development. Values here are development-only.
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=debug
LOG_FORMAT=text

# The API connects as the RLS-bound role, never as the owner.
DATABASE_URL=postgres://coachpulse_app:coachpulse_app@localhost:5432/coachpulse?sslmode=disable

# Must be at least 32 bytes. Generate with: openssl rand -hex 32
JWT_SIGNING_KEY=dev-only-signing-key-change-me!!
COLUMN_ENCRYPTION_KEY=dev-only-column-enc-key-change-me

STORAGE_ENDPOINT=localhost:9000
STORAGE_BUCKET=coachpulse
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_USE_SSL=false

PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8081
