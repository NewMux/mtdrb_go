# One origin for the whole product. Caddy obtains and renews the certificate
# for {$DOMAIN} itself; ports 80 and 443 must reach it.
{$DOMAIN} {
	encode zstd gzip

	# The API. It sets its own security headers, and reads the caller's
	# address from the X-Forwarded-For entry Caddy appends (TRUST_PROXY).
	@api path /v1/* /public/* /legal/* /healthz /readyz
	handle @api {
		reverse_proxy api:8080
	}

	# The app. Every route is a pre-rendered page; anything else falls back
	# to the shell, and the router takes it from there.
	handle {
		root * /srv
		@assets path /_expo/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header -Server
		header Strict-Transport-Security "max-age=31536000; includeSubDomains"
		header X-Content-Type-Options nosniff
		header Referrer-Policy no-referrer
		try_files {path} {path}.html /index.html
		file_server
	}
}

# Extra sites, such as the object store of a single-box install
# (deploy/web/files.caddy, mounted by the "local" profile). Nothing matches
# when storage is S3 or R2.
import /etc/caddy/extra/*.caddy
