# Production settings for deploy/compose.prod.yml. Copy to .env.production,
# fill in every value, and keep the file off version control (it is ignored).
# Generate secrets with: openssl rand -hex 32

# --- Where it lives -------------------------------------------------------
DOMAIN=app.example.com
PUBLIC_BASE_URL=https://app.example.com
APP_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
RELEASE=2026.10.1

# --- Database -------------------------------------------------------------
# The owner runs migrations (and cmd/admin); the API and worker connect as
# coachpulse_app, created by deploy/provision.sql. On a managed Postgres,
# require TLS: sslmode=require or stricter.
OWNER_DATABASE_URL=postgres://OWNER:PASSWORD@db.example.com:5432/coachpulse?sslmode=require
DATABASE_URL=postgres://coachpulse_app:APP_PASSWORD@db.example.com:5432/coachpulse?sslmode=require

# --- Secrets --------------------------------------------------------------
JWT_SIGNING_KEY=
COLUMN_ENCRYPTION_KEY=

# --- Object storage (S3, R2 or any S3-compatible store) -------------------
# The bucket must exist, be private, and allow CORS PUT/GET from DOMAIN.
STORAGE_ENDPOINT=ACCOUNT.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=coachpulse
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_USE_SSL=true

# --- Email (password resets) ----------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=starttls
MAIL_FROM=CoachPulse <no-reply@example.com>

# --- Legal (named on /legal/privacy and /legal/terms) ---------------------
LEGAL_ENTITY=
LEGAL_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_JURISDICTION=
LEGAL_EFFECTIVE=

# --- Optional -------------------------------------------------------------
# SENTRY_DSN=
# ACCOUNT_PURGE_AFTER=720h
# DB_STATEMENT_TIMEOUT=30s
# LOG_LEVEL=info

# --- Single-box install only (--profile local) ----------------------------
# Postgres and SeaweedFS run on this machine. Then also set:
#   OWNER_DATABASE_URL=postgres://coachpulse_owner:OWNER_DB_PASSWORD@postgres:5432/coachpulse?sslmode=disable
#   DATABASE_URL=postgres://coachpulse_app:APP_DB_PASSWORD@postgres:5432/coachpulse?sslmode=disable
#   DB_REQUIRE_TLS=false          # the database never leaves the Docker network
#   STORAGE_ENDPOINT=files.app.example.com
#   STORAGE_REGION=us-east-1
#   STORAGE_CREATE_BUCKET=true
#   CADDY_EXTRA=./web/extra-local # serves files.<DOMAIN>; point its DNS here too
# POSTGRES_PASSWORD=
# OWNER_DB_PASSWORD=
# APP_DB_PASSWORD=
